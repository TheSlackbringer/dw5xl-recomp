# 042: preserve the original ordered 64-file unity groups and physical TU identities.
function(dw5xl_write_generated path content)
    if(EXISTS "${path}")
        file(READ "${path}" previous)
        if("${previous}" STREQUAL "${content}")
            return()
        endif()
    endif()
    get_filename_component(parent "${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(WRITE "${path}" "${content}")
endfunction()

function(dw5xl_generated_sources target directory suffix result batched)
    file(GLOB physical CONFIGURE_DEPENDS "${directory}/*.cpp")
    set(manifest "${directory}/ps2_generated_sources.json")
    if(NOT EXISTS "${manifest}")
        if(EXISTS "${directory}/ps2_generated_index.json")
            message(FATAL_ERROR "Generated batch index has no sources manifest")
        endif()
        set(${result} ${physical} ${suffix} PARENT_SCOPE)
        set(${batched} FALSE PARENT_SCOPE)
        return()
    endif()
    if(NOT EXISTS "${directory}/ps2_generated_index.json")
        message(FATAL_ERROR "Generated batch sources have no function index")
    endif()
    file(READ "${manifest}" data)
    string(JSON schema GET "${data}" schema)
    string(JSON size GET "${data}" batch_size)
    string(JSON total GET "${data}" legacy_cpp_count)
    string(JSON count LENGTH "${data}" batches)
    if(NOT schema EQUAL 1 OR NOT size EQUAL 64 OR count LESS 1)
        message(FATAL_ERROR "Unsupported generated batch layout; DW5XL requires ordered groups of 64")
    endif()
    math(EXPR last "${count}-1")
    set(expected)
    set(sources)
    set(remaining ${suffix})
    set(sum 0)
    foreach(index RANGE 0 ${last})
        string(JSON name GET "${data}" batches ${index} file)
        string(JSON n GET "${data}" batches ${index} count)
        string(JSON bytes GET "${data}" batches ${index} bytes)
        if(NOT name MATCHES "^ps2_batch_[0-9]+[.]cpp$" OR NOT n MATCHES "^[0-9]+$" OR n LESS 1 OR n GREATER 64)
            message(FATAL_ERROR "Invalid generated batch entry")
        endif()
        if(index LESS last AND NOT n EQUAL 64)
            message(FATAL_ERROR "A nonfinal generated batch is incomplete")
        endif()
        if(NOT EXISTS "${directory}/${name}")
            message(FATAL_ERROR "A generated batch is missing")
        endif()
        file(SIZE "${directory}/${name}" actual_bytes)
        if(NOT actual_bytes EQUAL bytes)
            message(FATAL_ERROR "A generated batch is incomplete or modified")
        endif()
        list(APPEND expected "${directory}/${name}")
        set(text "/* generated: original unity group and TU identity */\n#include \"${directory}/${name}\"\n")
        math(EXPR capacity "64-${n}")
        while(capacity GREATER 0 AND remaining)
            list(POP_FRONT remaining extra)
            string(APPEND text "#include \"${extra}\"\n")
            math(EXPR capacity "${capacity}-1")
        endwhile()
        # These exact filenames preserve __BASE_FILE__-based per-TU stub state names (issue 027).
        set(path "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/${target}.dir/Unity/unity_${index}_cxx.cxx")
        dw5xl_write_generated("${path}" "${text}")
        list(APPEND sources "${path}")
        math(EXPR sum "${sum}+${n}")
    endforeach()
    if(NOT sum EQUAL total)
        message(FATAL_ERROR "Generated batch counts do not match the source inventory")
    endif()
    list(SORT physical)
    list(SORT expected)
    if(NOT "${physical}" STREQUAL "${expected}")
        message(FATAL_ERROR "Missing, extra or stale generated C++ beside batches")
    endif()
    set(index ${count})
    while(remaining)
        set(text "/* generated: original maintained unity tail */\n")
        set(n 0)
        while(n LESS 64 AND remaining)
            list(POP_FRONT remaining extra)
            string(APPEND text "#include \"${extra}\"\n")
            math(EXPR n "${n}+1")
        endwhile()
        set(path "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/${target}.dir/Unity/unity_${index}_cxx.cxx")
        dw5xl_write_generated("${path}" "${text}")
        list(APPEND sources "${path}")
        math(EXPR index "${index}+1")
    endwhile()
    set(${result} ${sources} PARENT_SCOPE)
    set(${batched} TRUE PARENT_SCOPE)
endfunction()

# Developer tests compiling a specific generated function keep their existing test source/body.
# Player builds do not materialize the legacy file set.
function(dw5xl_generated_function directory name result)
    if(NOT EXISTS "${directory}/ps2_generated_index.json")
        set(${result} "${directory}/${name}" PARENT_SCOPE)
        return()
    endif()
    file(READ "${directory}/ps2_generated_index.json" data)
    string(FIND "${data}" "\"name\":\"${name}\"" start)
    if(start LESS 0)
        message(FATAL_ERROR "Required diagnostic function is absent from the generated index")
    endif()
    math(EXPR start "${start}-1")
    string(SUBSTRING "${data}" ${start} -1 rest)
    string(FIND "${rest}" "}" finish)
    math(EXPR finish "${finish}+1")
    string(SUBSTRING "${rest}" 0 ${finish} entry)
    string(JSON file GET "${entry}" file)
    string(JSON offset GET "${entry}" offset)
    string(JSON bytes GET "${entry}" size)
    if(NOT file MATCHES "^ps2_batch_[0-9]+[.]cpp$" OR NOT offset MATCHES "^[0-9]+$" OR NOT bytes MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Invalid generated diagnostic range")
    endif()
    file(SIZE "${directory}/${file}" total)
    math(EXPR end "${offset}+${bytes}")
    if(end GREATER total)
        message(FATAL_ERROR "Generated diagnostic range exceeds its batch")
    endif()
    # CMake text READ/WRITE on Windows translates CRLF; index ranges count physical bytes.
    file(READ "${directory}/${file}" hex OFFSET ${offset} LIMIT ${bytes} HEX)
    string(LENGTH "${hex}" hex_size)
    math(EXPR expected_size "${bytes}*2")
    if(NOT hex_size EQUAL expected_size)
        message(FATAL_ERROR "Incomplete generated diagnostic byte range")
    endif()
    set(body "")
    math(EXPR last "${hex_size}-2")
    foreach(at RANGE 0 ${last} 2)
        string(SUBSTRING "${hex}" ${at} 2 pair)
        math(EXPR value "0x${pair}")
        if(value EQUAL 0)
            message(FATAL_ERROR "NUL byte in generated diagnostic source")
        endif()
        string(ASCII ${value} character)
        string(APPEND body "${character}")
    endforeach()
    if(CMAKE_HOST_WIN32)
        string(REPLACE "\r\n" "\n" body "${body}")
    endif()
    set(path "${CMAKE_CURRENT_BINARY_DIR}/diagnostic-generated/${name}")
    dw5xl_write_generated("${path}" "${body}")
    set(${result} "${path}" PARENT_SCOPE)
endfunction()
