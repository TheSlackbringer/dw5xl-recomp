# Hash the compiled generator component, not the whole launcher or its release number.
file(STRINGS "${OBJECT_LIST}" objects)
if(NOT objects)
    message(FATAL_ERROR "VU producer has no compiled objects")
endif()
set(identity "dw5xl-vu-producer-objects-2\n")
foreach(object IN LISTS objects)
    file(READ "${object}" bytes HEX)
    string(LENGTH "${bytes}" length)
    if(length LESS 40)
        message(FATAL_ERROR "VU producer object is incomplete")
    endif()
    string(SUBSTRING "${bytes}" 0 8 magic)
    string(SUBSTRING "${bytes}" 0 4 machine)
    # COFF timestamps change on every compile, even with identical code/headers/options.
    # Normalize only that metadata in the identity input; compiled files stay untouched.
    if(magic STREQUAL "0000ffff") # ANON_OBJECT_HEADER_BIGOBJ, timestamp at byte 8
        string(SUBSTRING "${bytes}" 0 16 before)
        string(SUBSTRING "${bytes}" 24 -1 after)
        set(bytes "${before}00000000${after}")
    elseif(machine STREQUAL "6486" OR machine STREQUAL "4c01" OR machine STREQUAL "64aa")
        string(SUBSTRING "${bytes}" 0 8 before)
        string(SUBSTRING "${bytes}" 16 -1 after)
        set(bytes "${before}00000000${after}")
    elseif(NOT magic STREQUAL "7f454c46") # ELF has no COFF timestamp
        message(FATAL_ERROR "Unsupported VU producer object format")
    endif()
    string(SHA256 hash "${bytes}")
    get_filename_component(name "${object}" NAME)
    string(APPEND identity "${name}:${hash}\n")
endforeach()
string(SHA256 hash "${identity}")
set(content "#pragma once\n#define DW5XL_VU_PRODUCER_ID \"${hash}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if("${old}" STREQUAL "${content}")
        return()
    endif()
endif()
get_filename_component(parent "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
file(WRITE "${OUT}" "${content}")
