# The generated list contains filenames only. All units are direct sources, with one registration owner.
function(dw5xl_vu_sources folder result)
    set(owner "${folder}/dw5xl_vu1_lifted.cpp")
    if(NOT EXISTS "${owner}")
        set(${result} "" PARENT_SCOPE)
        return()
    endif()
    set(sources "${owner}")
    if(EXISTS "${folder}/dw5xl_vu1_sources.txt")
        file(STRINGS "${folder}/dw5xl_vu1_sources.txt" names)
        list(POP_FRONT names schema)
        if(NOT schema STREQUAL "dw5xl-vu1-sources-1")
            message(FATAL_ERROR "Unsupported VU1 source inventory")
        endif()
        list(GET names 0 first)
        if(NOT first STREQUAL "dw5xl_vu1_lifted.cpp")
            message(FATAL_ERROR "VU1 source inventory has no registration owner")
        endif()
        set(sources "")
        set(index 0)
        foreach(name IN LISTS names)
            if(index GREATER 0 AND NOT name MATCHES "^dw5xl_vu1_unit_[0-9]+[.]cpp$")
                message(FATAL_ERROR "Invalid VU1 source filename")
            endif()
            if(NOT EXISTS "${folder}/${name}")
                message(FATAL_ERROR "Missing VU1 compile unit: ${name}")
            endif()
            list(APPEND sources "${folder}/${name}")
            math(EXPR index "${index}+1")
        endforeach()
        file(GLOB actual "${folder}/*.cpp")
        list(SORT sources)
        list(SORT actual)
        if(NOT "${sources}" STREQUAL "${actual}")
            message(FATAL_ERROR "VU1 compile-unit inventory is incomplete or contains stale files")
        endif()
    endif()
    set(${result} "${sources}" PARENT_SCOPE)
endfunction()
