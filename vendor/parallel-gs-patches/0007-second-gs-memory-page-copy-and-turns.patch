+bool PageTracker::page_may_super_sample(uint32_t page) const
+{
+	return (page_state[page & page_state_mask].flags & PAGE_STATE_MAY_SUPER_SAMPLE_BIT) != 0;
+}
+
+void PageTracker::set_page_may_super_sample(uint32_t page, bool enable)
+{
+	auto &state = page_state[page & page_state_mask];
+	if (enable)
+		state.flags |= PAGE_STATE_MAY_SUPER_SAMPLE_BIT;
+	else
+		state.flags &= ~PAGE_STATE_MAY_SUPER_SAMPLE_BIT;
+}
