--- a/Granite/vulkan/wsi.hpp
+++ b/Granite/vulkan/wsi.hpp
@@ -316,6 +316,29 @@
 	// 2 -> Conservative, but useful when GPU bound to avoid pumping. Forced when using low gpu submit latency path.
 	void set_present_wait_latency(uint32_t latency);
 
+	// DW5XL (issue 049, amendment v3.13): no wait for the driver without a limit.
+	// The longest the presenter waits in one place for the driver: for a free swapchain image, for an earlier
+	// present to have been shown (the present wait of a vsynced swapchain), and for a swapchain's last presents when
+	// it is torn down. UINT64_MAX (the default): no limit, the library's own behaviour.
+	// A wait of begin_frame() that ran into the limit is noted (take_wait_timeout). begin_frame() returns false
+	// when it was the wait for an image; when it was the wait for an earlier present it goes on with the frame.
+	enum class WaitKind { None, AcquireImage, PresentShown };
+	struct WaitTimeout
+	{
+		WaitKind kind = WaitKind::None;
+		uint64_t present_id = 0; // PresentShown: the present waited for; AcquireImage: the one about to be made
+		uint64_t waited_ns = 0;
+	};
+	void set_wait_limit(uint64_t nanoseconds);
+	// The wait that ran into the limit since the last call, if any (the latest one).
+	bool take_wait_timeout(WaitTimeout &timeout);
+	// The swapchain is made anew at the next begin_frame(), as after a resize: the old one's presents are not
+	// waited for.
+	void request_new_swapchain();
+	// Tests: after `after_frames` more calls of begin_frame(), the next `count` waits of `kind` get no answer:
+	// each lasts the limit and is noted, as when the driver stays silent.
+	void set_wait_test_fault(WaitKind kind, uint64_t after_frames, uint32_t count);
+
 	// For external swapchains we don't have a normal acquire -> present cycle.
 	// - set_external_frame()
 	//   - index replaces the acquire next image index.
@@ -415,6 +438,14 @@
 	VkImageUsageFlags current_extra_usage = 0;
 	VkImageUsageFlags extra_usage = 0;
