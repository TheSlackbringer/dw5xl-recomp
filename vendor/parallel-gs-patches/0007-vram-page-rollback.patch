+// DW5XL issue 049: the rollback point (gs_interface.hpp).
+void GSInterface::rollback_save(const uint32_t *pages, size_t num_pages)
+{
+	// Everything submitted so far lands in VRAM and the CLUT first (this also flushes pending palette uploads).
+	flush();
+
+	rollback_pages.assign(pages, pages + num_pages);
+	std::sort(rollback_pages.begin(), rollback_pages.end());
+	rollback_pages.erase(std::unique(rollback_pages.begin(), rollback_pages.end()), rollback_pages.end());
+
+	rollback_page_super_sampled.clear();
+	std::vector<std::pair<VkDeviceSize, VkDeviceSize>> ranges;
+	for (uint32_t page : rollback_pages)
+	{
+		rollback_page_super_sampled.push_back(tracker.page_may_super_sample(page));
+		VkDeviceSize offset = VkDeviceSize(page) * PageSize;
+		if (!ranges.empty() && ranges.back().first + ranges.back().second == offset)
+			ranges.back().second += PageSize;
+		else
+			ranges.emplace_back(offset, VkDeviceSize(PageSize));
+	}
+
+	// Only the slices the current sampling rate uses hold anything (as dispatch_cache_read_only_depth counts them).
+	uint32_t sample_rate_log2 = sampling_rate_x_log2 + sampling_rate_y_log2;
+	uint32_t num_slices = sample_rate_log2 ? 2u + (1u << sample_rate_log2) : 1u;
+	renderer.rollback_save(ranges, render_pass.clut_instance, num_slices);
+	rollback_sample_rate_log2 = sample_rate_log2;
+	rollback_valid = true;
+}
+
+size_t GSInterface::rollback_add(const uint32_t *pages, size_t num_pages)
+{
+	if (!rollback_valid)
+		return 0;
+
+	std::vector<uint32_t> more;
+	for (size_t i = 0; i < num_pages; i++)
+	{
+		if (std::find(rollback_pages.begin(), rollback_pages.end(), pages[i]) == rollback_pages.end() &&
+		    std::find(more.begin(), more.end(), pages[i]) == more.end())
+			more.push_back(pages[i]);
+	}
+	if (more.empty())
+		return 0;
+
+	// Everything submitted before the write that is about to come lands first.
+	flush();
+
+	std::sort(more.begin(), more.end());
+	std::vector<std::pair<VkDeviceSize, VkDeviceSize>> ranges;
+	for (uint32_t page : more)
+	{
+		rollback_pages.push_back(page);
+		rollback_page_super_sampled.push_back(tracker.page_may_super_sample(page));
+		VkDeviceSize offset = VkDeviceSize(page) * PageSize;
+		if (!ranges.empty() && ranges.back().first + ranges.back().second == offset)
+			ranges.back().second += PageSize;
+		else
+			ranges.emplace_back(offset, VkDeviceSize(PageSize));
+	}
+	renderer.rollback_add(ranges);
+	return more.size();
+}
+
+bool GSInterface::copy_pages_from(GSInterface &source, const uint32_t *pages, size_t num_pages)
+{
+	if (&source == this || source.vram_size != vram_size)
+		return false;
+
+	// What either side has submitted lands first: the source's pages are as they are after its work so far, and
+	// this GS's own work on those pages is done before they are overwritten.
+	source.flush();
+	flush();
+
+	std::vector<uint32_t> list(pages, pages + num_pages);
+	std::sort(list.begin(), list.end());
+	list.erase(std::unique(list.begin(), list.end()), list.end());
+	std::vector<std::pair<VkDeviceSize, VkDeviceSize>> ranges;
+	for (uint32_t page : list)
+	{
+		VkDeviceSize offset = VkDeviceSize(page) * PageSize;
+		if (!ranges.empty() && ranges.back().first + ranges.back().second == offset)
+			ranges.back().second += PageSize;
+		else
+			ranges.emplace_back(offset, VkDeviceSize(PageSize));
+	}
+
+	// With different sampling rates only the single-rate slice means the same on both sides.
+	uint32_t sample_rate_log2 = sampling_rate_x_log2 + sampling_rate_y_log2;
+	bool same_rate = sample_rate_log2 == source.sampling_rate_x_log2 + source.sampling_rate_y_log2;
+	uint32_t num_slices = same_rate && sample_rate_log2 ? 2u + (1u << sample_rate_log2) : 1u;
+	uint32_t clut_instance = (render_pass.clut_instance + 1) % CLUTInstances;
+	renderer.copy_pages_from(source.renderer, ranges, num_slices, source.render_pass.clut_instance, clut_instance);
+
+	for (uint32_t page : list)
+	{
+		PageRect rect = {};
+		rect.base_page = page;
+		rect.page_width = 1;
+		rect.page_height = 1;
+		rect.block_mask = UINT32_MAX;
+		rect.write_mask = UINT32_MAX;
+		tracker.mark_external_write(rect);
+		tracker.set_page_may_super_sample(page, same_rate && source.tracker.page_may_super_sample(page));
+	}
+
+	render_pass.clut_instance = clut_instance;
+	render_pass.latest_clut_instance = clut_instance;
+	renderer.rewind_clut_instance(clut_instance);
+	render_pass.num_memoized_palettes = 0;
+	mark_texture_state_dirty();
+	return true;
+}
+
+bool GSInterface::rollback_restore()
+{
+	if (!rollback_valid)
+		return false;
+	rollback_valid = false;
+
+	// The extra pictures' work is done before their pages are overwritten.
+	flush();
+
+	// The saved CLUT becomes a fresh instance, the current one from here on.
+	uint32_t clut_instance = (render_pass.clut_instance + 1) % CLUTInstances;
+	// A change of the sampling rate since the save cleared the reference and sample slices.
+	bool rate_changed = rollback_sample_rate_log2 != sampling_rate_x_log2 + sampling_rate_y_log2;
+	renderer.rollback_restore(clut_instance, rate_changed);
+
+	for (size_t i = 0; i < rollback_pages.size(); i++)
+	{
+		uint32_t page = rollback_pages[i];
+		PageRect rect = {};
+		rect.base_page = page;
+		rect.page_width = 1;
+		rect.page_height = 1;
+		rect.block_mask = UINT32_MAX;
+		rect.write_mask = UINT32_MAX;
+		// As any write outside the tracked paths: textures cached from the page go, the host copy is refreshed.
+		tracker.mark_external_write(rect);
+		tracker.set_page_may_super_sample(page, !rate_changed && rollback_page_super_sampled[i]);
+	}
+
+	render_pass.clut_instance = clut_instance;
+	render_pass.latest_clut_instance = clut_instance;
+	renderer.rewind_clut_instance(clut_instance);
+	// Memoized palettes describe a history that no longer applies.
+	render_pass.num_memoized_palettes = 0;
+	mark_texture_state_dirty();
+	return true;
+}
+
+uint64_t GSInterface::rollback_bytes() const
+{
+	return renderer.rollback_bytes();
+}
