+// DW5XL issue 049: the rollback point (gs_renderer.hpp).
+VkDeviceSize GSRenderer::rollback_saved_bytes() const
+{
+	VkDeviceSize bytes = 0;
+	for (auto &range : rollback_ranges)
+		bytes += range.second;
+	return bytes * rollback_slices + CLUTSize;
+}
+
+VkDeviceSize GSRenderer::rollback_bytes() const
+{
+	VkDeviceSize bytes = rollback_saved_bytes();
+	for (auto &extra : rollback_extras)
+		for (auto &range : extra.ranges)
+			bytes += range.second * rollback_slices;
+	return bytes;
+}
+
+void GSRenderer::rollback_copy_extra(Vulkan::CommandBuffer &cmd, bool restore, const RollbackExtra &extra,
+                                     uint32_t num_slices)
+{
+	VkDeviceSize side = 0;
+	for (uint32_t slice = 0; slice < num_slices; slice++)
+	{
+		for (auto &range : extra.ranges)
+		{
+			VkDeviceSize vram = VkDeviceSize(vram_size) * slice + range.first;
+			if (restore)
+				cmd.copy_buffer(*buffers.gpu, vram, *extra.buffer, side, range.second);
+			else
+				cmd.copy_buffer(*extra.buffer, side, *buffers.gpu, vram, range.second);
+			side += range.second;
+		}
+	}
+}
+
+void GSRenderer::rollback_add(const std::vector<std::pair<VkDeviceSize, VkDeviceSize>> &ranges)
+{
+	if (!rollback_buffer || ranges.empty() || rollback_slices == 0)
+		return;
+
+	RollbackExtra extra;
+	extra.ranges = ranges;
+	VkDeviceSize bytes = 0;
+	for (auto &range : ranges)
+		bytes += range.second;
+
+	Vulkan::BufferCreateInfo info = {};
+	info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+	info.domain = Vulkan::BufferDomain::Device;
+	info.size = bytes * rollback_slices;
+	extra.buffer = device->create_buffer(info);
+	device->set_name(*extra.buffer, "rollback-added");
+
+	auto cmd = device->request_command_buffer();
+	cmd->begin_region("rollback-add");
+	cmd->barrier(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_MEMORY_WRITE_BIT,
+	             VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+	rollback_copy_extra(*cmd, false, extra, rollback_slices);
+	cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+	             VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT);
+	cmd->end_region();
+	device->submit(cmd);
+	rollback_extras.push_back(std::move(extra));
+}
+
+void GSRenderer::rollback_copy(bool restore, uint32_t clut_instance, uint32_t num_slices)
+{
+	auto cmd = device->request_command_buffer();
+	cmd->begin_region(restore ? "rollback-restore" : "rollback-save");
+	cmd->barrier(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_MEMORY_WRITE_BIT,
+	             VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+
+	VkDeviceSize side = 0;
+	for (uint32_t slice = 0; slice < num_slices; slice++)
+	{
+		for (auto &range : rollback_ranges)
+		{
+			VkDeviceSize vram = VkDeviceSize(vram_size) * slice + range.first;
+			if (restore)
+				cmd->copy_buffer(*buffers.gpu, vram, *rollback_buffer, side, range.second);
+			else
+				cmd->copy_buffer(*rollback_buffer, side, *buffers.gpu, vram, range.second);
+			side += range.second;
+		}
+	}
+
+	// What was added after the save goes back with the rest.
+	if (restore)
+		for (auto &extra : rollback_extras)
+			rollback_copy_extra(*cmd, true, extra, num_slices);
+
+	// The CLUT sits after the last saved slice.
+	side = rollback_saved_bytes() - CLUTSize;
+	VkDeviceSize clut = VkDeviceSize(clut_instance) * CLUTSize;
+	if (restore)
+		cmd->copy_buffer(*buffers.clut, clut, *rollback_buffer, side, CLUTSize);
+	else
+		cmd->copy_buffer(*rollback_buffer, side, *buffers.clut, clut, CLUTSize);
+
+	cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+	             VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT);
+	cmd->end_region();
+	device->submit(cmd);
+}
+
+void GSRenderer::rollback_save(const std::vector<std::pair<VkDeviceSize, VkDeviceSize>> &ranges, uint32_t clut_instance,
+                               uint32_t num_slices)
+{
+	// The lower half of the buffer holds the slices; the upper half is the read-only cache.
+	rollback_slices = std::min<uint32_t>(num_slices, uint32_t(buffers.gpu->get_create_info().size / 2 / vram_size));
+	rollback_ranges = ranges;
+	rollback_extras.clear();
+
+	VkDeviceSize needed = rollback_saved_bytes();
+	if (!rollback_buffer || rollback_buffer->get_create_info().size < needed)
+	{
+		Vulkan::BufferCreateInfo info = {};
+		info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+		info.domain = Vulkan::BufferDomain::Device;
+		info.size = needed;
+		rollback_buffer = device->create_buffer(info);
+		device->set_name(*rollback_buffer, "rollback");
+	}
+
+	rollback_copy(false, clut_instance, rollback_slices);
+}
+
+void GSRenderer::copy_pages_from(GSRenderer &source, const std::vector<std::pair<VkDeviceSize, VkDeviceSize>> &ranges,
+                                 uint32_t num_slices, uint32_t source_clut, uint32_t clut_instance)
+{
+	auto cmd = device->request_command_buffer();
+	cmd->begin_region("copy-pages-from");
+	cmd->barrier(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_MEMORY_WRITE_BIT,
+	             VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+	num_slices = std::min<uint32_t>(num_slices, uint32_t(buffers.gpu->get_create_info().size / 2 / vram_size));
+	for (uint32_t slice = 0; slice < num_slices; slice++)
+	{
+		for (auto &range : ranges)
+		{
+			VkDeviceSize vram = VkDeviceSize(vram_size) * slice + range.first;
+			cmd->copy_buffer(*buffers.gpu, vram, *source.buffers.gpu, vram, range.second);
+		}
+	}
+	cmd->copy_buffer(*buffers.clut, VkDeviceSize(clut_instance) * CLUTSize,
+	                 *source.buffers.clut, VkDeviceSize(source_clut) * CLUTSize, CLUTSize);
+	cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+	             VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT);
+	cmd->end_region();
+	device->submit(cmd);
+}
+
+void GSRenderer::set_frame_context_hold(std::function<bool()> hold)
+{
+	frame_context_hold = std::move(hold);
+}
+
+bool GSRenderer::has_open_command_buffers() const
+{
+	return direct_cmd || async_transfer_cmd || triangle_setup_cmd || clear_cmd || heuristic_cmd || binning_cmd;
+}
+
+void GSRenderer::rollback_restore(uint32_t clut_instance, bool single_rate_only)
+{
+	if (rollback_buffer)
+		rollback_copy(true, clut_instance, single_rate_only ? 1u : rollback_slices);
+	rollback_extras.clear();
+}
