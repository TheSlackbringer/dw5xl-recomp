+// First super sample shown at a pixel of the full (both axes) high-resolution scanout.
+uint first_sample_at(uvec2 super_sampled_coord, uint num_ssaa_samples)
+{
+    if (OUTPUT_SHIFT == 0u)
+        return 0u;
+
+    if (OUTPUT_SHIFT == 1u)
+    {
+        uint quad_offset;
+        // The swizzling pattern for checkerboard is a bit different.
+        if (NUM_SAMPLES != 8u)
+            quad_offset = (super_sampled_coord.y & 1u) + (super_sampled_coord.x & 1u) * 2u;
+        else
+            quad_offset = (super_sampled_coord.x & 1u) + (super_sampled_coord.y & 1u) * 2u;
+        return num_ssaa_samples * quad_offset;
+    }
+
+    // Ordered 4x4 grid: y = bit0 + 2 * bit2, x = bit1 + 2 * bit3.
+    uvec2 sub = super_sampled_coord & 3u;
+    return (sub.y & 1u) | ((sub.x & 1u) << 1u) | ((sub.y >> 1u) << 2u) | ((sub.x >> 1u) << 3u);
