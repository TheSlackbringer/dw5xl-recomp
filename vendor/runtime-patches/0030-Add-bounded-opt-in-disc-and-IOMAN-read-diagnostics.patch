From 51de4cc7f7050e44e7df6b40f766b7e15553d5f7 Mon Sep 17 00:00:00 2001
From: Fizban <35464167+Fiztba@users.noreply.github.com>
Date: Fri, 9 Oct 2026 22:49:12 -0400
Subject: [PATCH] Add bounded opt-in disc and IOMAN read diagnostics

---
 ps2xIOP/src/emulator/imports/iop_ioman.cpp    | 38 +++++++++++++++++-
 ps2xRuntime/src/lib/Kernel/Stubs/CD.cpp       | 40 ++++++++++++++++++-
 .../src/lib/Kernel/Stubs/Helpers/Support.h    | 13 ++++--
 3 files changed, 85 insertions(+), 6 deletions(-)

diff --git a/ps2xIOP/src/emulator/imports/iop_ioman.cpp b/ps2xIOP/src/emulator/imports/iop_ioman.cpp
index d84cb9d..be842c4 100644
--- a/ps2xIOP/src/emulator/imports/iop_ioman.cpp
+++ b/ps2xIOP/src/emulator/imports/iop_ioman.cpp
@@ -7,6 +7,8 @@
 #include <algorithm>
 #include <cctype>
 #include <cstdio>
+#include <cstdlib>
+#include <cstring>
 #include <filesystem>
 #include <string>
 
@@ -14,6 +16,27 @@ namespace ps2x::iop::detail
 {
     namespace
     {
+        bool traceIoOperation()
+        {
+            static const bool enabled = []
+            {
+                const char *value = std::getenv("PS2X_IO_TRACE");
+                return value && *value && std::strcmp(value, "0") != 0;
+            }();
+            if (!enabled) return false;
+            static const uint64_t limit = []
+            {
+                const char *value = std::getenv("PS2X_IO_TRACE_LIMIT");
+                if (!value || !*value) return uint64_t{4096u};
+                char *end = nullptr;
+                const uint64_t parsed = std::strtoull(value, &end, 10);
+                return end != value && *end == '\0' && parsed != 0u
+                           ? std::min<uint64_t>(parsed, 1000000u) : uint64_t{4096u};
+            }();
+            static uint64_t count = 0u;
+            return count++ < limit;
+        }
+
         // "cdrom0:\\DATA\\KF4.DAT;1" -> "DATA/KF4.DAT" (relative to the working
         // directory, which holds the unpacked disc). Components are matched
         // case-insensitively because ISO9660 names are upper case.
@@ -118,6 +141,9 @@ namespace ps2x::iop::detail
             }
             const int32_t fd = m_nextFd++;
             m_files[fd] = file;
+            if (traceIoOperation())
+                std::fprintf(stderr, "[io:ioman] pc=%08x open fd=%d flags=%08x guest=\"%s\" path=\"%s\"\n",
+                             cpu.pc, fd, a1, guestPath.c_str(), hostPath.c_str());
             setV0(static_cast<uint32_t>(fd));
             return true;
         }
@@ -145,6 +171,8 @@ namespace ps2x::iop::detail
             }
             std::vector<uint8_t> buffer(a2);
             size_t done = 0u;
+            const bool trace = traceIoOperation();
+            const long before = trace ? std::ftell(file) : 0;
             if (ordinal == 6u)
             {
                 done = a2 ? std::fread(buffer.data(), 1u, a2, file) : 0u;
@@ -156,6 +184,10 @@ namespace ps2x::iop::detail
                 if (a2 && m_memory.readRam(a1, buffer.data(), a2))
                     done = std::fwrite(buffer.data(), 1u, a2, file);
             }
+            if (trace)
+                std::fprintf(stderr, "[io:ioman] pc=%08x %s fd=%d offset=%ld dst=%08x requested=%u actual=%zu error=%d\n",
+                             cpu.pc, ordinal == 6u ? "read" : "write", static_cast<int32_t>(a0),
+                             before, a1, a2, done, std::ferror(file));
             setV0(static_cast<uint32_t>(done));
             return true;
         }
@@ -168,7 +200,11 @@ namespace ps2x::iop::detail
                 return true;
             }
             const int whence = a2 == 1u ? SEEK_CUR : (a2 == 2u ? SEEK_END : SEEK_SET);
-            if (std::fseek(file, static_cast<long>(static_cast<int32_t>(a1)), whence) != 0)
+            const int result = std::fseek(file, static_cast<long>(static_cast<int32_t>(a1)), whence);
+            if (traceIoOperation())
+                std::fprintf(stderr, "[io:ioman] pc=%08x seek fd=%d offset=%d whence=%u result=%d position=%ld\n",
+                             cpu.pc, static_cast<int32_t>(a0), static_cast<int32_t>(a1), a2, result, std::ftell(file));
+            if (result != 0)
             {
                 setV0(static_cast<uint32_t>(-22));
                 return true;
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/CD.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/CD.cpp
index 2330528..d46017f 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/CD.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/CD.cpp
@@ -31,6 +31,27 @@ namespace ps2_stubs
         uint32_t g_cdStReadTraceCount = 0u;
         CdStreamTimingState g_cdStreamTiming;
 
+        bool traceIoRead()
+        {
+            static const bool enabled = []
+            {
+                const char *value = std::getenv("PS2X_IO_TRACE");
+                return value && *value && std::strcmp(value, "0") != 0;
+            }();
+            if (!enabled) return false;
+            static const uint64_t limit = []
+            {
+                const char *value = std::getenv("PS2X_IO_TRACE_LIMIT");
+                if (!value || !*value) return uint64_t{4096u};
+                char *end = nullptr;
+                const uint64_t parsed = std::strtoull(value, &end, 10);
+                return end != value && *end == '\0' && parsed != 0u
+                           ? std::min<uint64_t>(parsed, 1000000u) : uint64_t{4096u};
+            }();
+            static uint64_t count = 0u;
+            return count++ < limit;
+        }
+
         uint64_t currentCdStreamTick(PS2Runtime *runtime)
         {
             return runtime != nullptr ? runtime->eeScheduler().currentVSyncTick() : 0u;
@@ -259,7 +280,24 @@ namespace ps2_stubs
                 return true;
             }
 
-            return readCdSectors(args.lbn, args.sectors, rdram + offset, bytes);
+            const bool trace = traceIoRead();
+            size_t actualBytes = 0u;
+            const bool success = readCdSectors(args.lbn, args.sectors, rdram + offset, bytes,
+                                               trace ? &actualBytes : nullptr);
+            if (trace)
+            {
+                CdFileEntry entry{};
+                const bool mapped = findRegisteredCdFileForLbn(args.lbn, entry);
+                const std::string path = mapped ? entry.hostPath.string() : getCdImagePath().string();
+                const uint64_t fileOffset = static_cast<uint64_t>(mapped ? args.lbn - entry.baseLbn : args.lbn) * kCdSectorSize;
+                std::fprintf(stderr, "[io:cd] tick=%llu pc=%08x ra=%08x lbn=%08x sectors=%u dst=%08x "
+                                     "path=\"%s\" offset=%llu requested=%zu actual=%zu ok=%u error=%d\n",
+                             static_cast<unsigned long long>(currentCdStreamTick(runtime)), ctx->pc,
+                             getRegU32(ctx, 31), args.lbn, args.sectors, args.buf, path.c_str(),
+                             static_cast<unsigned long long>(fileOffset), bytes, actualBytes,
+                             success ? 1u : 0u, g_lastCdError);
+            }
+            return success;
         };
 
         CdReadArgs selected{a0, a1, a2, "a0/a1/a2"};
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h b/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
index b1bb6d8..17b6d28 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
@@ -399,8 +399,10 @@ namespace
         return true;
     }
 
-    bool readHostRange(const std::filesystem::path &path, uint64_t offsetBytes, uint8_t *dst, size_t byteCount)
+    bool readHostRange(const std::filesystem::path &path, uint64_t offsetBytes, uint8_t *dst, size_t byteCount,
+                       size_t *bytesRead = nullptr)
     {
+        if (bytesRead) *bytesRead = 0u;
         if (!dst)
         {
             g_lastCdError = -1;
@@ -428,12 +430,15 @@ namespace
         }
 
         file.read(reinterpret_cast<char *>(dst), static_cast<std::streamsize>(byteCount));
+        if (bytesRead) *bytesRead = static_cast<size_t>(std::max<std::streamsize>(0, file.gcount()));
         g_lastCdError = 0;
         return true;
     }
 
-    bool readCdSectors(uint32_t lbn, uint32_t sectors, uint8_t *dst, size_t byteCount)
+    bool readCdSectors(uint32_t lbn, uint32_t sectors, uint8_t *dst, size_t byteCount,
+                       size_t *bytesRead = nullptr)
     {
+        if (bytesRead) *bytesRead = 0u;
         for (const auto &[key, entry] : g_cdFilesByKey)
         {
             const uint32_t endLbn = entry.baseLbn + entry.sectors;
@@ -444,7 +449,7 @@ namespace
 
             const uint64_t relativeLbn = static_cast<uint64_t>(lbn - entry.baseLbn);
             const uint64_t offset = relativeLbn * kCdSectorSize;
-            return readHostRange(entry.hostPath, offset, dst, byteCount);
+            return readHostRange(entry.hostPath, offset, dst, byteCount, bytesRead);
         }
 
         const std::filesystem::path cdImage = getCdImagePath();
@@ -463,7 +468,7 @@ namespace
             }
 
             const uint64_t offset = static_cast<uint64_t>(lbn) * kCdSectorSize;
-            return readHostRange(cdImage, offset, dst, byteCount);
+            return readHostRange(cdImage, offset, dst, byteCount, bytesRead);
         }
 
         std::cerr << "sceCdRead unresolved LBN 0x" << std::hex << lbn
-- 
2.55.0.windows.3

