From 1223108c879370e90f74d3b81da84a6e16a803e4 Mon Sep 17 00:00:00 2001
From: Fizban <35464167+Fiztba@users.noreply.github.com>
Date: Fri, 9 Oct 2026 23:57:03 -0400
Subject: [PATCH] Service registered MPEG input callbacks after real picture
 handoff

The SDK services NODATA after decoded output, following UPDATE. Dispatch that registered callback at each genuine picture handoff so clients can reconcile consumed input DMA and prime their next batch. Preserve ordinary callback ABI, registration order and generation cancellation; empty decoders emit no picture service.

Native Windows production-source MPEG fixtures pass 789 checks and all eight CTests, including actual FFmpeg picture handoff, multiple input callbacks, reset/delete/CD-generation/recreate cancellation and unchanged compressed-byte and DMA accounting.
---
 ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
index dfbd9ef..570d405 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
@@ -2577,6 +2577,16 @@ namespace ps2_stubs
                 update.callbacks = matchingOrdinaryCallbacks(mpegAddr, 4u);
                 if (!update.callbacks.empty())
                     pictureCallbacks.push_back(std::move(update));
+                // The SDK services NODATA after the picture's output DMA.
+                // Let the registered input consumer reconcile real DMA
+                // progress and prime the next batch after UPDATE completes.
+                MpegStreamCallbackEvent input{};
+                input.mpegAddr = mpegAddr;
+                input.callbackGeneration = playback.callbackGeneration;
+                input.streamType = 1u;
+                input.callbacks = matchingOrdinaryCallbacks(mpegAddr, 1u);
+                if (!input.callbacks.empty())
+                    pictureCallbacks.push_back(std::move(input));
                 if (g_mpeg_stub_state.pictureTraceCount < 32u)
                 {
                     PS2_IF_AGRESSIVE_LOGS({
