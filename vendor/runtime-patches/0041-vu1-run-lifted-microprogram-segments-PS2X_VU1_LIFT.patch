+# Lifted VU1 microprograms (runtime/ps2_vu1_lift.h). They are generated per
+# game from its microcode and are not part of this repository. They register
+# themselves from static initializers, so they are linked into the runner
+# rather than the runtime library, and are built outside the unity batches
+# and the PCH, with run-time rounding (the VU rounds toward zero) and no FMA
+# contraction.
+file(GLOB PS2X_VU1_LIFT_SRC_FILES CONFIGURE_DEPENDS
+    "${CMAKE_CURRENT_SOURCE_DIR}/src/vu1lift/*.cpp"
+)
+if(PS2X_VU1_LIFT_SRC_FILES)
+    target_sources(ps2EntryRunner PRIVATE ${PS2X_VU1_LIFT_SRC_FILES})
+    set_source_files_properties(${PS2X_VU1_LIFT_SRC_FILES} PROPERTIES
+        SKIP_UNITY_BUILD_INCLUSION TRUE
+        SKIP_PRECOMPILE_HEADERS TRUE
+    )
+    if(NOT MSVC)
+        set_property(SOURCE ${PS2X_VU1_LIFT_SRC_FILES} APPEND PROPERTY
+            COMPILE_OPTIONS -frounding-math -ffp-contract=off)
+    endif()
+endif()
+
 if(PS2X_ENABLE_RUNNER_PCH)
     set(PS2X_RUNNER_PCH_HEADERS
         "${CMAKE_CURRENT_SOURCE_DIR}/include/ps2_runtime_macros.h"
