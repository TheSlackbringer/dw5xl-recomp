+        case 7u: // END
+            dataAddress = inlineAddress;
+            nextTag = inlineAddress + words * 16u;
+            break;
+        }
+        if (!dmaPointer(dataAddress, static_cast<uint64_t>(words) * 16u))
+            return;
+        const bool tagInterrupt = (tag & 0x80000000ull) != 0u && (chcr & 0x80u) != 0u;
+        chcr = (chcr & 0x0000FFCFu) | (asp << 4u) |
+               (static_cast<uint32_t>(tag) & 0xFFFF0000u);
+        madr = dataAddress;
+        qwc = words;
+        m_ioRegisters[base + 0x30u] = nextTag;
+        m_ipuInputTagLoaded = true;
+        m_ipuInputEndAfterPayload = terminal || tagInterrupt;
+    }
+}
