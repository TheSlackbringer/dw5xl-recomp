+                return;
+            if (mode == 1u && !m_ipuInputTagLoaded)
+            {
+                // A guest may restore an already loaded channel snapshot.
+                const uint32_t id = (chcr >> 28u) & 7u;
+                m_ipuInputEndAfterPayload = id == 0u || id == 7u ||
+                    ((chcr & 0x80u) != 0u && (chcr & 0x80000000u) != 0u);
+                m_ipuInputTagLoaded = true;
+            }
+            const uint64_t retiredQw = std::min<uint64_t>(qwc, m_ipuInputCredit / 16u);
+            if (retiredQw == 0u)
+                return;
+            const uint32_t retiredBytes = static_cast<uint32_t>(retiredQw * 16u);
+            madr += retiredBytes;
+            qwc -= static_cast<uint32_t>(retiredQw);
+            m_ipuInputCredit -= retiredBytes;
+            if (qwc != 0u)
+                return;
+        }
+
+        if (mode == 0u || (m_ipuInputTagLoaded && m_ipuInputEndAfterPayload))
+        {
+            m_ipuInputTagLoaded = false;
+            m_ipuInputEndAfterPayload = false;
+            completeDmacChannel(base, 4u);
+            return;
+        }
+        m_ipuInputTagLoaded = false;
+        if (fetchedTags++ == maxTags)
+            return;
+
+        const uint32_t tagAddress = m_ioRegisters[base + 0x30u];
+        const uint8_t *tagPointer = dmaPointer(tagAddress, 16u);
+        if (!tagPointer || (tagAddress & 15u) != 0u)
+            return;
+        uint64_t tag = 0u;
+        std::memcpy(&tag, tagPointer, sizeof(tag));
+        const uint32_t words = static_cast<uint32_t>(tag) & 0xFFFFu;
+        const uint32_t id = (static_cast<uint32_t>(tag) >> 28u) & 7u;
+        const uint32_t address = static_cast<uint32_t>(tag >> 32u);
+        const uint32_t inlineAddress = tagAddress + 16u;
+        uint32_t dataAddress = address;
+        uint32_t nextTag = inlineAddress;
+        uint32_t asp = (chcr >> 4u) & 3u;
