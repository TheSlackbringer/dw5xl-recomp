+void PS2Memory::resetIpuInputConsumption() noexcept
+{
+    m_ipuInputCredit = 0u;
+    m_ipuInputTagLoaded = false;
+    m_ipuInputEndAfterPayload = false;
+    const auto chcr = m_ioRegisters.find(0x1000B400u);
+    if (chcr != m_ioRegisters.end())
+        chcr->second &= ~0x100u;
