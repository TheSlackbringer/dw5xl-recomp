+        case 0u: // REFE: referenced payload, then terminate.
+        case 3u: // REF
+        case 4u: // REFS (stall arbitration is outside this native sink).
+            break;
+        case 1u: // CNT
+            dataAddress = inlineAddress;
+            nextTag = inlineAddress + words * 16u;
+            break;
+        case 2u: // NEXT, including the retail circular tag-table sentinel.
+            dataAddress = inlineAddress;
+            nextTag = address;
+            break;
+        case 5u: // CALL
+            if (asp >= 2u)
