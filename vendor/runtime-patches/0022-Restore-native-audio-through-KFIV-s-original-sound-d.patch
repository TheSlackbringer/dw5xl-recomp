+
+void PS2Memory::processIpuInputConsumption()
+{
+    constexpr uint32_t base = 0x1000B400u;
+    auto chcrIt = m_ioRegisters.find(base);
+    if (chcrIt == m_ioRegisters.end() || (chcrIt->second & 0x100u) == 0u)
+        return;
+    const auto control = m_ioRegisters.find(0x1000E000u);
+    if (control != m_ioRegisters.end() && (control->second & 1u) == 0u)
+        return;
+    const uint32_t mode = (chcrIt->second >> 2u) & 3u;
+    if (mode > 1u || (chcrIt->second & 1u) == 0u)
+        return;
+
+    // DMAC addresses use bit31 for scratchpad, rather than the CPU's KSEG
+    // alias. Reject invalid payloads instead of wrapping them into unrelated
+    // RAM and reporting a completion which never happened.
+    auto dmaPointer = [this](uint32_t address, uint64_t bytes) -> const uint8_t *
+    {
+        const bool scratch = (address & 0x80000000u) != 0u;
+        const uint32_t offset = address & 0x7FFFFFFFu;
+        const uint32_t limit = scratch ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+        const uint8_t *region = scratch ? m_scratchpad : m_rdram;
+        if (!region || offset > limit || bytes > static_cast<uint64_t>(limit - offset))
+            return nullptr;
+        return region + offset;
+    };
+
+    // Tag-only cycles cannot earn input credit. Bound malformed zero-length
+    // loops while retaining the active DMA for a later guest STOP/reset.
+    constexpr unsigned maxTags = 4096u;
+    unsigned fetchedTags = 0u;
+    for (;;)
+    {
+        uint32_t &chcr = m_ioRegisters[base];
+        uint32_t &qwc = m_ioRegisters[base + 0x20u];
+        uint32_t &madr = m_ioRegisters[base + 0x10u];
+        if (qwc != 0u)
