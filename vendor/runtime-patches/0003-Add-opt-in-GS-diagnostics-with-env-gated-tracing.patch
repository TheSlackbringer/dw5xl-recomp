 ps2xRuntime/src/lib/gs/gs_cpu_backend.cpp |   4 +
 ps2xRuntime/src/lib/gs/gs_frontend.cpp    |  25 +
 ps2xRuntime/src/lib/gs/gs_trace.cpp       | 694 ++++++++++++++++++++++
 ps2xRuntime/src/lib/gs/gs_trace.h         |  55 ++
 ps2xRuntime/src/lib/ps2_runtime.cpp       |   5 +
 6 files changed, 784 insertions(+)
 create mode 100644 ps2xRuntime/src/lib/gs/gs_trace.cpp
 create mode 100644 ps2xRuntime/src/lib/gs/gs_trace.h

