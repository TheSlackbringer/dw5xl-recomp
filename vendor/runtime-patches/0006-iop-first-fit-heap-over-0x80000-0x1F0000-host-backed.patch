From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Priestley <voicedrew11@gmail.com>
Date: Sat, 3 Oct 2026 13:04:09 -0400
Subject: [PATCH 06/14] iop: first-fit heap over 0x80000-0x1F0000; host-backed
 ioman file I/O

The heap only searched above its high-water mark, so freed blocks were
never reused and KF4's movie player could not allocate its 160 KB
stream buffer (SifAllocIopHeap Error). ioman open/close/read/write/
lseek/ioctl now map cdrom0:/host: paths to the unpacked disc, which
FSIOPSND.IRX needs.
---
 ps2xIOP/src/emulator/core/iop_memory.cpp   |  30 ++++-
 ps2xIOP/src/emulator/core/iop_memory.h     |   5 +-
 ps2xIOP/src/emulator/imports/iop_ioman.cpp | 150 +++++++++++++++++++++
 ps2xIOP/src/emulator/imports/iop_ioman.h   |   6 +
 4 files changed, 188 insertions(+), 3 deletions(-)

diff --git a/ps2xIOP/src/emulator/core/iop_memory.cpp b/ps2xIOP/src/emulator/core/iop_memory.cpp
index 25e9b36..edd3455 100644
--- a/ps2xIOP/src/emulator/core/iop_memory.cpp
+++ b/ps2xIOP/src/emulator/core/iop_memory.cpp
@@ -1,3 +1,5 @@
+#include <vector>
+#include <cstdio>
 #include "iop_memory.h"
 
 #include <algorithm>
@@ -299,7 +301,10 @@ namespace ps2x::iop::detail
             return address;
         }
 
-        uint32_t candidate = alignUp(m_heapCursor, alignment);
+        // First fit from the heap base so freed blocks are reused, like the
+        // IOP sysmem allocator (the old cursor-only search leaked every block
+        // freed below the high-water mark).
+        uint32_t candidate = alignUp(HeapBase, alignment);
         for (;;)
         {
             bool overlap = false;
@@ -316,7 +321,11 @@ namespace ps2x::iop::detail
                 break;
         }
         if (candidate > HeapLimit || size > HeapLimit - candidate)
+        {
+            std::fprintf(stderr, "[iop:mem] allocate(0x%x) failed: heap exhausted (%zu blocks live)\n",
+                         size, m_allocations.size());
             return 0u;
+        }
         m_allocations.push_back({candidate, size});
         markOwned(candidate, size);
         m_heapCursor = std::max(m_heapCursor, candidate + size);
@@ -339,7 +348,24 @@ namespace ps2x::iop::detail
 
     uint32_t IopMemory::maxFreeMemory() const
     {
-        return m_heapCursor < HeapLimit ? HeapLimit - m_heapCursor : 0u;
+        std::vector<Allocation> blocks;
+        for (const auto &block : m_allocations)
+            if (block.address + block.size > HeapBase && block.address < HeapLimit)
+                blocks.push_back(block);
+        std::sort(blocks.begin(), blocks.end(),
+                  [](const Allocation &a, const Allocation &b)
+                  { return a.address < b.address; });
+        uint32_t cursor = HeapBase;
+        uint32_t largest = 0u;
+        for (const auto &block : blocks)
+        {
+            if (block.address > cursor)
+                largest = std::max(largest, block.address - cursor);
+            cursor = std::max(cursor, block.address + block.size);
+        }
+        if (HeapLimit > cursor)
+            largest = std::max(largest, HeapLimit - cursor);
+        return largest;
     }
 
     std::optional<IopMemory::Allocation> IopMemory::allocationContaining(uint32_t address) const
diff --git a/ps2xIOP/src/emulator/core/iop_memory.h b/ps2xIOP/src/emulator/core/iop_memory.h
index a932a5d..53d6852 100644
--- a/ps2xIOP/src/emulator/core/iop_memory.h
+++ b/ps2xIOP/src/emulator/core/iop_memory.h
@@ -22,7 +22,10 @@ namespace ps2x::iop::detail
         static constexpr uint32_t Spu2End = 0x1FA00000u;
         static constexpr uint32_t SifBase = 0x1D000000u;
         static constexpr uint32_t SifEnd = 0x1D001000u;
-        static constexpr uint32_t HeapBase = 0x00120000u;
+        // IRX modules load from 0x10000 upward (kModuleLoadBase); KF4's nine
+        // modules end below 0x60000. The heap starts above that and runs up to
+        // the emulator's call-stack area.
+        static constexpr uint32_t HeapBase = 0x00080000u;
         static constexpr uint32_t HeapLimit = 0x001F0000u;
 
         struct Allocation
diff --git a/ps2xIOP/src/emulator/imports/iop_ioman.cpp b/ps2xIOP/src/emulator/imports/iop_ioman.cpp
index 3eb4119..973d200 100644
--- a/ps2xIOP/src/emulator/imports/iop_ioman.cpp
+++ b/ps2xIOP/src/emulator/imports/iop_ioman.cpp
@@ -5,9 +5,64 @@
 #include "../services/iop_rpc.h"
 
 #include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <filesystem>
+#include <string>
 
 namespace ps2x::iop::detail
 {
+    namespace
+    {
+        // "cdrom0:\\DATA\\KF4.DAT;1" -> "DATA/KF4.DAT" (relative to the working
+        // directory, which holds the unpacked disc). Components are matched
+        // case-insensitively because ISO9660 names are upper case.
+        std::string resolveHostPath(const std::string &guestPath)
+        {
+            std::string path = guestPath;
+            const size_t colon = path.find(':');
+            if (colon != std::string::npos)
+                path = path.substr(colon + 1u);
+            const size_t semi = path.rfind(';');
+            if (semi != std::string::npos)
+                path = path.substr(0u, semi);
+            std::replace(path.begin(), path.end(), '\\', '/');
+            while (!path.empty() && path.front() == '/')
+                path.erase(path.begin());
+
+            std::filesystem::path resolved = ".";
+            size_t start = 0u;
+            while (start <= path.size())
+            {
+                const size_t slash = path.find('/', start);
+                const std::string part = path.substr(start, slash == std::string::npos ? std::string::npos : slash - start);
+                start = (slash == std::string::npos) ? path.size() + 1u : slash + 1u;
+                if (part.empty())
+                    continue;
+                std::filesystem::path next = resolved / part;
+                std::error_code ec;
+                if (!std::filesystem::exists(next, ec) && std::filesystem::is_directory(resolved, ec))
+                {
+                    for (const auto &entry : std::filesystem::directory_iterator(resolved, ec))
+                    {
+                        const std::string name = entry.path().filename().string();
+                        if (name.size() == part.size() &&
+                            std::equal(name.begin(), name.end(), part.begin(),
+                                       [](char a, char b)
+                                       { return std::toupper(static_cast<unsigned char>(a)) ==
+                                                std::toupper(static_cast<unsigned char>(b)); }))
+                        {
+                            next = entry.path();
+                            break;
+                        }
+                    }
+                }
+                resolved = next;
+            }
+            return resolved.string();
+        }
+    }
+
     IopIoman::IopIoman(IopMemory &memory) noexcept
         : m_memory(memory)
     {
@@ -16,6 +71,10 @@ namespace ps2x::iop::detail
     void IopIoman::reset()
     {
         m_devices.clear();
+        for (auto &file : m_files)
+            std::fclose(file.second);
+        m_files.clear();
+        m_nextFd = 3;
     }
 
     bool IopIoman::dispatchImport(uint16_t ordinal, IopCpuState &cpu, IopGuestExecutor &executor)
@@ -27,8 +86,99 @@ namespace ps2x::iop::detail
             cpu.gpr[2] = value;
         };
 
+        const uint32_t a1 = cpu.gpr[5];
+        const uint32_t a2 = cpu.gpr[6];
+        const auto fileFor = [&](uint32_t fd) -> std::FILE *
+        {
+            const auto it = m_files.find(static_cast<int32_t>(fd));
+            return it == m_files.end() ? nullptr : it->second;
+        };
+        constexpr uint32_t kEBADF = static_cast<uint32_t>(-9);
+        constexpr uint32_t kENOENT = static_cast<uint32_t>(-2);
+
         switch (ordinal)
         {
+        case 4: // open(name, flags, mode)
+        {
+            const std::string guestPath = m_memory.readString(a0, 256u);
+            const std::string hostPath = resolveHostPath(guestPath);
+            // IOP O_* flags: RDONLY 1, WRONLY 2, RDWR 3, APPEND 0x100, CREAT 0x200, TRUNC 0x400
+            const uint32_t access = a1 & 3u;
+            const char *mode = "rb";
+            if (access == 2u || access == 3u)
+                mode = (a1 & 0x200u) ? ((a1 & 0x400u) || access == 2u ? "w+b" : "r+b") : "r+b";
+            std::FILE *file = std::fopen(hostPath.c_str(), mode);
+            if (!file && (a1 & 0x200u))
+                file = std::fopen(hostPath.c_str(), "w+b");
+            if (!file)
+            {
+                std::fprintf(stderr, "[iop:ioman] open(\"%s\") -> %s: not found\n", guestPath.c_str(), hostPath.c_str());
+                setV0(kENOENT);
+                return true;
+            }
+            const int32_t fd = m_nextFd++;
+            m_files[fd] = file;
+            setV0(static_cast<uint32_t>(fd));
+            return true;
+        }
+        case 5: // close(fd)
+        {
+            const auto it = m_files.find(static_cast<int32_t>(a0));
+            if (it == m_files.end())
+            {
+                setV0(kEBADF);
+                return true;
+            }
+            std::fclose(it->second);
+            m_files.erase(it);
+            setV0(0u);
+            return true;
+        }
+        case 6: // read(fd, buf, size)
+        case 7: // write(fd, buf, size)
+        {
+            std::FILE *file = fileFor(a0);
+            if (!file)
+            {
+                setV0(kEBADF);
+                return true;
+            }
+            std::vector<uint8_t> buffer(a2);
+            size_t done = 0u;
+            if (ordinal == 6u)
+            {
+                done = a2 ? std::fread(buffer.data(), 1u, a2, file) : 0u;
+                if (done && !m_memory.writeRam(a1, buffer.data(), done))
+                    done = 0u;
+            }
+            else
+            {
+                if (a2 && m_memory.readRam(a1, buffer.data(), a2))
+                    done = std::fwrite(buffer.data(), 1u, a2, file);
+            }
+            setV0(static_cast<uint32_t>(done));
+            return true;
+        }
+        case 8: // lseek(fd, offset, whence)
+        {
+            std::FILE *file = fileFor(a0);
+            if (!file)
+            {
+                setV0(kEBADF);
+                return true;
+            }
+            const int whence = a2 == 1u ? SEEK_CUR : (a2 == 2u ? SEEK_END : SEEK_SET);
+            if (std::fseek(file, static_cast<long>(static_cast<int32_t>(a1)), whence) != 0)
+            {
+                setV0(static_cast<uint32_t>(-22));
+                return true;
+            }
+            setV0(static_cast<uint32_t>(std::ftell(file)));
+            return true;
+        }
+        case 9: // ioctl(fd, cmd, arg): no host-file ioctls; report success
+            setV0(fileFor(a0) ? 0u : kEBADF);
+            return true;
         case 20: // AddDrv
         {
             if (a0 == 0u || m_devices.size() >= kMaxDevices)
diff --git a/ps2xIOP/src/emulator/imports/iop_ioman.h b/ps2xIOP/src/emulator/imports/iop_ioman.h
index 182f786..416dd66 100644
--- a/ps2xIOP/src/emulator/imports/iop_ioman.h
+++ b/ps2xIOP/src/emulator/imports/iop_ioman.h
@@ -1,6 +1,8 @@
 #pragma once
 
 #include <cstdint>
+#include <cstdio>
+#include <map>
 #include <string>
 #include <vector>
 
@@ -28,5 +30,9 @@ namespace ps2x::iop::detail
 
         IopMemory &m_memory;
         std::vector<Device> m_devices;
+        // Host-backed files for ioman open/read/... on disc (cdrom0:) and
+        // host: paths, resolved under the runtime's working directory.
+        std::map<int32_t, std::FILE *> m_files;
+        int32_t m_nextFd = 3;
     };
