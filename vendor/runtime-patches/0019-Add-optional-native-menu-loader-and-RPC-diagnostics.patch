+        void logCompletedRpcTrace(const SifRpcDebugEvent &event)
+        {
+            static const bool enabled = []
+            {
+                const char *value = std::getenv("PS2X_RPC_TRACE");
+                return value && value[0] != '\0' && std::strcmp(value, "0") != 0;
+            }();
+            if (!enabled)
+            {
+                return;
+            }
+            uint64_t signature = 1469598103934665603ull;
+            const auto mix = [&](uint32_t value)
+            {
+                signature = (signature ^ value) * 1099511628211ull;
+            };
+            mix(event.sid);
+            mix(event.rpcNum);
+            for (uint32_t i = 0; i < event.sendPreviewSize; ++i) mix(event.sendPreview[i]);
+            for (uint32_t i = 0; i < event.recvPreviewSize; ++i) mix(event.recvPreview[i]);
+            // SifCallRpc already serializes this path. Repeated polling replies
+            // are sampled at powers of two to keep diagnostic runs manageable.
+            static std::unordered_map<uint64_t, uint64_t> counts;
+            if (counts.size() >= 4096u && counts.find(signature) == counts.end()) return;
+            const uint64_t count = ++counts[signature];
+            if (count > 4u && (count & (count - 1u)) != 0u) return;
+            std::fprintf(stderr,
+                         "[rpc-complete] sid=0x%08x function=0x%x ra=0x%08x "
+                         "flags=0x%x result=0x%08x count=%llu send=[%s] recv=[%s]\n",
+                         event.sid, event.rpcNum, event.ra, event.flags, event.resultPtr,
+                         static_cast<unsigned long long>(count),
+                         formatRpcTraceBytes(event.sendPreview, event.sendPreviewSize).c_str(),
+                         formatRpcTraceBytes(event.recvPreview, event.recvPreviewSize).c_str());
+        }
+
 #ifndef PS2X_ENABLE_IOP_RPC_TRACE
 #define PS2X_ENABLE_IOP_RPC_TRACE 1
 #endif
@@ -638,6 +675,7 @@ namespace ps2_syscalls
                 fillRpcDebugPreview(rdram, sendBuf, sendSize, event.sendPreview, event.sendPreviewSize);
                 fillRpcDebugPreview(rdram, receiveBuffer, receiveSize, event.recvPreview, event.recvPreviewSize);
                 event.result = 0;
+                logCompletedRpcTrace(event);
 #if PS2X_ENABLE_IOP_RPC_TRACE
                 if ((event.flags & kSifRpcDebugFlagUnhandled) != 0u)
                 {
