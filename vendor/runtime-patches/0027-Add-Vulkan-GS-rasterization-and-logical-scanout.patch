--- /dev/null
+++ b/ps2xRuntime/cmake/VulkanGs.cmake
@@ -0,0 +1,20 @@
+# paraLLEl-GS is LGPL-3.0-or-later; Granite and submodules retain their licenses.
+option(PS2X_ENABLE_VULKAN_GS "Build the Vulkan compute GS renderer" OFF)
+set(PS2X_PARALLEL_GS_SOURCE_DIR "" CACHE PATH "Pinned paraLLEl-GS checkout with minimal submodules")
+if(PS2X_ENABLE_VULKAN_GS)
+    if(NOT EXISTS "${PS2X_PARALLEL_GS_SOURCE_DIR}/gs/gs_interface.cpp")
+        message(FATAL_ERROR "Set PS2X_PARALLEL_GS_SOURCE_DIR to paraLLEl-GS cc6184af7e0c03da603045ca371ffa5dae9b0655 with Granite, volk and Vulkan-Headers initialized")
+    endif()
+    set(PARALLEL_GS_STANDALONE ON CACHE BOOL "" FORCE)
+    set(GRANITE_TOOLS OFF CACHE BOOL "" FORCE)
+    set(GRANITE_RENDERDOC_CAPTURE OFF CACHE BOOL "" FORCE)
+    set(GRANITE_INSTALL_TARGETS OFF CACHE BOOL "" FORCE)
+    set(GRANITE_VULKAN_DXGI_INTEROP OFF CACHE BOOL "" FORCE)
+    if(MSVC)
+        set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
+    endif()
+    add_subdirectory("${PS2X_PARALLEL_GS_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/parallel-gs" EXCLUDE_FROM_ALL)
+    target_sources(ps2_runtime PRIVATE src/lib/gs/gs_vulkan_backend.cpp src/lib/gs/gs_vulkan_scanout.cpp)
+    target_link_libraries(ps2_runtime PRIVATE parallel-gs)
+    target_compile_definitions(ps2_runtime PRIVATE PS2X_HAS_VULKAN_GS=1)
+endif()
