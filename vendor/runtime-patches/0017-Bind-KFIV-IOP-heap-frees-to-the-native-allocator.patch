+        bool iopHeapTraceEnabled()
+        {
+            static const bool enabled = []
+            {
+                const char *value = std::getenv("PS2X_IOP_HEAP_TRACE");
+                return value && value[0] != '\0' && std::strcmp(value, "0") != 0;
+            }();
